# IncidentLens reads this file from the directory you run `incidentlens` in.
# Copy to `.env` and fill in only what you use. Real environment variables
# always take precedence over anything set here.

# --- service settings (only these use the INCIDENTLENS_ prefix) ---
INCIDENTLENS_ENV=development
INCIDENTLENS_LOG_LEVEL=INFO
INCIDENTLENS_HOST=127.0.0.1
INCIDENTLENS_PORT=8000

# --- narration model (only needed for `--narration llm`) ---
# Pick ONE provider. The provider is inferred from the model id unless forced.
#
# Claude (Anthropic):
#   ANTHROPIC_API_KEY=sk-ant-...
#   INCIDENTLENS_NARRATION_MODEL=claude-opus-4-8      # or claude-sonnet-5
#
# OpenAI-compatible (hosted OpenAI, or your Gateway -> ModelProvider gateway):
#   OPENAI_API_KEY=...
#   INCIDENTLENS_NARRATION_PROVIDER=openai
#   INCIDENTLENS_NARRATION_MODEL=gpt-5.1
#   INCIDENTLENS_OPENAI_BASE_URL=https://your-llm-gateway/v1
#
# NOTE: these configure the NARRATOR that writes the video's script — NOT the
# models hary-ai uses. You do not copy hary-ai's MODEL_PROVIDER_* model ids here.

# --- voice ---
# OpenAI neural voice (recommended for polished demos):
#   OPENAI_API_KEY=...
#   INCIDENTLENS_OPENAI_VOICE=marin
#   INCIDENTLENS_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Genblaze-orchestrated OpenAI voice (Python 3.11+ and the `genblaze` extra):
#   INCIDENTLENS_GENBLAZE_VOICE=coral
# Genblaze 0.3.x does not yet accept the newer `marin` or `cedar` voices.
# It reuses INCIDENTLENS_OPENAI_TTS_MODEL and the delivery prompt below.
# Optional: override the calm default delivery prompt:
#   INCIDENTLENS_OPENAI_VOICE_INSTRUCTIONS=Speak warmly and at a measured pace.
# Optional: a speech-specific compatible endpoint. The narration gateway URL
# is deliberately NOT reused because many chat gateways do not expose TTS.
# This applies to direct `--voice openai`; Genblaze TTS calls hosted OpenAI:
#   INCIDENTLENS_OPENAI_TTS_BASE_URL=https://api.openai.com/v1
#
# Offline/other providers:
# INCIDENTLENS_PIPER_MODEL=/path/to/en_US-ryan-high.onnx
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# --- Backblaze B2 through Genblaze (`--upload-genblaze-b2`) ---
# Genblaze's canonical variable names:
#   B2_BUCKET=incidentlens-demo
#   B2_REGION=us-west-004
#   B2_KEY_ID=...
#   B2_APP_KEY=...
# Optional, only for an intentionally public bucket:
#   B2_PUBLIC_URL_BASE=https://f004.backblazeb2.com/file/incidentlens-demo
# Optional object prefix (default: incidentlens):
#   INCIDENTLENS_B2_PREFIX=incidentlens
#
# IncidentLens also accepts its legacy names on the Genblaze path:
#   B2_APPLICATION_KEY=...  # used when B2_APP_KEY is absent
#   B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
#                                ^ region is derived when B2_REGION is absent
# If B2_APP_KEY and B2_APPLICATION_KEY are both set, their values must match
# or Genblaze publication fails. B2_REGION takes precedence over a region
# derived from B2_ENDPOINT_URL.
#
# The legacy `--upload-b2` path still requires B2_BUCKET, B2_ENDPOINT_URL,
# B2_KEY_ID, and B2_APPLICATION_KEY and returns a time-limited presigned URL.
